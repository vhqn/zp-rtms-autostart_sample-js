# =============================================================================
# Zoom Phone RTMS App - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Zoom App Credentials (Required - from Zoom Marketplace)
# -----------------------------------------------------------------------------
ZOOM_APP_CLIENT_ID=6JWTvGchRLiZ0kwC4Fxvw
ZOOM_APP_CLIENT_SECRET=fWXQSeq3Knv25Xur5EedfT4HlKBN49I4
ZOOM_SECRET_TOKEN=lRvdvaluSbOlEfs4-A8dog

# -----------------------------------------------------------------------------
# Zoom Configuration
# -----------------------------------------------------------------------------
# Default: https://zoom.us  (use https://us06web.zoom.us for Zoom for Government)
ZOOM_HOST=https://zoomdev.us
ZOOM_API_BASE_URL=https://api.zoomdev.us/v2

# -----------------------------------------------------------------------------
# Server Ports
# -----------------------------------------------------------------------------
PORT=3000
BACKEND_PORT=3001
RTMS_PORT=8080

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# URLs Configuration
# -----------------------------------------------------------------------------
# Public URL (部署到 10.203.64.174)
PUBLIC_URL=https://newdevzprtms.zoomdev.us:3001
# Frontend URL (set to the same URL for OAuth redirects)
FRONTEND_URL=https://newdevzprtms.zoomdev.us:3001

# Frontend Internal URL
# Docker: http://frontend:3000
# Local (npm run dev:local): http://localhost:3000
FRONTEND_INTERNAL_URL=http://frontend:3000


# RTMS server URL
# Docker: http://rtms:8080
# Local: http://localhost:8080
RTMS_SERVER_URL=http://rtms:8080

# Backend URL (used by RTMS server to send status updates back to backend)
# Docker: http://backend:3001
# Local: http://localhost:3001
BACKEND_URL=http://backend:3001

# OAuth callback URL (must match Zoom Marketplace settings)
ZOOM_REDIRECT_URL=https://newdevzprtms.zoomdev.us:3001/api/auth/callback

# -----------------------------------------------------------------------------
# Frontend Configuration (React env vars must start with REACT_APP_)
# -----------------------------------------------------------------------------
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_ZOOM_CLIENT_ID=6JWTvGchRLiZ0kwC4Fxvw

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
