# Zoom Phone RTMS - 10.203.64.174 部署配置
# 复制此文件到项目根目录的 .env

# ============================================
# Zoom 应用凭证（从 Marketplace 获取）
# ============================================
ZOOM_APP_CLIENT_ID=your_client_id_here
ZOOM_APP_CLIENT_SECRET=your_client_secret_here
ZOOM_SECRET_TOKEN=your_secret_token_here

# Session 密钥（生成随机值）
# 生成方法: openssl rand -hex 32
SESSION_SECRET=your_random_session_secret_here

# ============================================
# 公网 URL 配置（10.203.64.174）
# 域名: newqa01mszone7.zoomdev.us → 38.111.222.121
# ============================================
PUBLIC_URL=https://newqa01mszone7.zoomdev.us:3001
ZOOM_REDIRECT_URL=https://newqa01mszone7.zoomdev.us:3001/api/auth/callback
FRONTEND_URL=https://newqa01mszone7.zoomdev.us:3001

# ============================================
# 内部服务 URL（Docker 网络，不要修改）
# ============================================
FRONTEND_INTERNAL_URL=http://frontend:3000
RTMS_SERVER_URL=http://rtms:8080
BACKEND_URL=http://backend:3001

# ============================================
# 端口配置（不要修改）
# ============================================
PORT=3000
BACKEND_PORT=3001
RTMS_PORT=8080

# ============================================
# Zoom API 配置
# ============================================
ZOOM_HOST=https://zoom.us
ZOOM_API_BASE_URL=https://api.zoom.us/v2

# ============================================
# 环境配置
# ============================================
NODE_ENV=production

# ============================================
# 可选：开发调试配置
# ============================================
# 启用详细日志（生产环境建议关闭）
LOG_FULL_WEBHOOK_PAYLOAD=false
LOG_WEBSOCKET_EVENTS=false

# 测试用 Access Token（可选，仅用于开发测试）
ZOOM_TEST_ACCESS_TOKEN=
